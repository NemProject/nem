{% extends "_base/class.html.jinja" %}

{% block heading scoped %}
	{# Additional short anchor for convenience #}
	<a id={{ class.name }}></a>
	{{ super() }}
{% endblock heading %}

{% block docstring scoped %}
	<dl class="automatic-reference-term"><dt>py:{{ class.name }}</dt><dd>
	{%- with docstring_sections = class.docstring.parsed -%}
		{%- include "docstring"|get_template with context -%}
	{%- endwith -%}
	</dd></dl>
{% endblock docstring %}
